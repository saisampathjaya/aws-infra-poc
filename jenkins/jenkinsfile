pipeline {
    agent {
        label 'kaniko'
    }

    environment {
        AWS_REGION = 'ap-south-1'
        ECR_REPO = '667523685556.dkr.ecr.ap-south-1.amazonaws.com/sample-app-repo'
    }

    stages {

        stage('Checkout Application Repo') {
            steps {
                git branch: 'main',
                    credentialsId: 'git',
                    url: 'https://github.com/saisampathjaya/aws-infra-poc.git'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    def scannerHome = tool 'sonar-scanner'

                    withSonarQubeEnv('sonarqube') {
                        sh """
                        ${scannerHome}/bin/sonar-scanner \
                        -Dsonar.projectKey=aws-infra-poc \
                        -Dsonar.sources=. \
                        -Dsonar.sourceEncoding=UTF-8
                        """
                    }
                }
            }
        }

        stage('Trivy Repo Scan') {
            steps {
                container('trivy') {
                    sh '''
                    trivy config . \
                      --severity HIGH,CRITICAL \
                      --exit-code 0 \
                      -f table > trivy-repo-report.txt

                    echo "===== Trivy Repository Scan Report ====="
                    cat trivy-repo-report.txt
                    '''
      
