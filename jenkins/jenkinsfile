pipeline {
    agent {
        label 'kaniko'
    }

    environment {
        AWS_REGION = 'ap-south-1'
        ECR_REPO = '667523685556.dkr.ecr.ap-south-1.amazonaws.com/sample-app-repo'
    }

    stages {

        stage('Checkout Application Repo') {
            steps {
                git branch: 'main',
                    credentialsId: 'git',
                    url: 'https://github.com/saisampathjaya/aws-infra-poc.git'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('sonarqube') {
                    sh '''
                    sonar-scanner \
                      -Dsonar.projectKey=aws-infra-poc \
                      -Dsonar.sources=. \
                      -Dsonar.host.url=$SONAR_HOST_URL \
                      -Dsonar.token=$SONAR_AUTH_TOKEN
                    '''
                }
            }
        }

        stage('Build and Push Image') {
            steps {
                container('kaniko') {

                    withCredentials([
                        usernamePassword(
                            credentialsId: 'aws-accesskey',
                            usernameVariable: 'AWS_ACCESS_KEY_ID',
                            passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                        )
                    ]) {

                        dir('sample-app') {

                            sh """
                            /kaniko/executor \
                              --context=\$(pwd) \
                              --dockerfile=Dockerfile \
                              --destination=${ECR_REPO}:${BUILD_NUMBER}
                            """
                        }
                    }
                }
            }
        }

        stage('Manual Approval') {
            steps {
                input message: 'Approve deployment?', ok: 'Deploy'
            }
        }

        stage('Update GitOps Repo')
